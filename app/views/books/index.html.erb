<h1>Books</h1>

<% if notice %><p style="color: green;"><%= notice %></p><% end %>
<% if alert %><p style="color: red;"><%= alert %></p><% end %>

<table border="1" cellpadding="8">
  <thead>
    <tr><th>Title</th><th>Author</th><th>Due</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.due_date&.strftime("%b %d") %></td>
        <td><%= book.checked_out? ? "Checked out" : "Available" %></td>
        <td>
          <% if book.checked_out? %>
            <%= button_to "Return", check_in_book_path(book), method: :patch %>
          <% else %>
            <%= button_to "Check out", check_out_book_path(book), method: :patch %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
